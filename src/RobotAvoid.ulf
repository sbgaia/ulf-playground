/**
 * Port of the "Obstacle Avoidance" exercise of the Robot lab (RobotAvoidSolution.lf).
 *
 * The robot drives in a square, like in RobotSquare.ulf. When one of its bumpers 
 * hits an obstacle, it backs off, turns away from the obstacle, and then carries 
 * on with a new side of the square.
 */
import Display from "lib/Display.ulf"
import RobotSim from "lib/RobotSim.ulf"

@platform("native")
@timeout(14 s)
main reactor {
  robot = new RobotSim()
  display = new Display()

  state distance: float = 0
  state angle: float = 0
  state start: float = 0
  state away: float = 0

  @max_pending_events(2)
  logical action bumper: int

  reaction(startup) -> bumper {=
    lf_schedule(bumper, MSEC(3200), 'l');
    lf_schedule(bumper, MSEC(6200), 'r');
  =}

  reaction(robot.distance, robot.angle) {=
    self->distance = robot.distance->value;
    self->angle = robot.angle->value;
  =}

  initial mode INIT {
    timer go(1 sec)
    reaction(go) -> reset(DRIVING) {=
      lf_set_mode(DRIVING);
    =}
  }

  mode DRIVING {
    reaction(reset) -> robot.left_power, robot.right_power, display.line0 {=
      self->start = self->distance;
      lf_set(robot.left_power, 0.2f);
      lf_set(robot.right_power, 0.2f);
      lf_set(display.line0, "DRIVING");
    =}

    reaction(robot.distance) -> reset(TURNING) {=
      if (self->distance - self->start >= 0.5f) lf_set_mode(TURNING);
    =}

    reaction(bumper) -> reset(BACKING) {=
      if (bumper->value == 'l') {
        self->away = -45.0f;
        lf_set_mode(BACKING);
      } else if (bumper->value == 'r') {
        self->away = 45.0f;
        lf_set_mode(BACKING);
      }
    =}
  }

  mode TURNING {
    reaction(reset) -> robot.left_power, robot.right_power, display.line0 {=
      self->start = self->angle;
      lf_set(robot.left_power, -0.05f);
      lf_set(robot.right_power, 0.05f);
      lf_set(display.line0, "TURNING");
    =}

    reaction(robot.angle) -> reset(DRIVING) {=
      if (self->angle - self->start >= 90.0f) lf_set_mode(DRIVING);
    =}
  }

  mode BACKING {
    timer backed_off(500 msec)

    reaction(reset) -> robot.left_power, robot.right_power, display.line0 {=
      lf_set(robot.left_power, -0.1f);
      lf_set(robot.right_power, -0.1f);
      lf_set(display.line0, "BACKING");
    =}

    reaction(backed_off) -> reset(AVOIDING) {=
      lf_set_mode(AVOIDING);
    =}
  }

  mode AVOIDING {
    reaction(reset) -> robot.left_power, robot.right_power, display.line0 {=
      self->start = self->angle;
      float spin = self->away > 0 ? 0.05f : -0.05f;
      lf_set(robot.left_power, -spin);
      lf_set(robot.right_power, spin);
      lf_set(display.line0, "AVOIDING");
    =}

    reaction(robot.angle) -> reset(DRIVING) {=
      if (fabsf(self->angle - self->start) >= fabsf(self->away)) lf_set_mode(DRIVING);
    =}
  }
}
